rules_version = '2';

// Firestore (database "ailaw"): the website never reads or writes it
// directly. Every request goes through the doors (client, lawyer, admin),
// which check who is asking; the doors use the admin SDK, which these
// rules don't limit.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
